---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await post.render();
const tocHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${post.data.title} - Justin Bornais`}>
  <main class="min-h-screen bg-neutral-900 py-12 px-6">
    <div class="max-w-7xl mx-auto flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,48rem)_minmax(0,1fr)]">
      <article class="order-2 w-full max-w-3xl mx-auto lg:order-none lg:col-start-2 lg:max-w-[32rem] xl:max-w-3xl">
        <a
          href="/blog"
          class="text-blue-400 hover:text-blue-300 mb-8 inline-block transition-colors"
        >
          &larr; Back to Blog
        </a>

        <header class="mb-8">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
            {post.data.title}
          </h1>
          <div class="flex items-center gap-4 text-gray-400">
            <span>{post.data.author}</span>
            <span>•</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          {post.data.tags.length > 0 && (
            <div class="flex gap-2 mt-4">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs bg-neutral-700 text-gray-300 px-2 py-1 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-invert prose-lg max-w-none">
          <Content />
        </div>
      </article>

      {tocHeadings.length > 0 && (
        <aside class="blog-toc order-1 mb-8 lg:order-none lg:col-start-3 lg:row-start-1 lg:mb-0 lg:ml-auto lg:-mt-12 lg:w-48 lg:self-start lg:min-h-[calc(100vh-4rem)] xl:w-64">
          <nav aria-label="Table of contents">
            <p class="blog-toc-title">On this page</p>
            <ul>
              {tocHeadings.map((heading) => (
                <li class:list={{ 'blog-toc-nested': heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </main>
</Layout>

<style is:global>
  .prose {
    color: #d1d5db;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    color: white;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose h1 {
    font-size: 2.25rem;
    font-weight: 700;
  }
  .prose h2 {
    font-size: 1.75rem;
    font-weight: 600;
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }
  .prose ul, .prose ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose strong {
    color: white;
    font-weight: 600;
  }
  .prose em {
    color: #9ca3af;
  }
  .prose a {
    color: #60a5fa;
    text-decoration: underline;
  }
  .prose a:hover {
    color: #93c5fd;
  }
  .prose code {
    background: #374151;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .prose pre {
    background: #1f2937;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
  }
  .prose blockquote {
    border-left: 4px solid #4b5563;
    padding-left: 1rem;
    margin-left: 0;
    color: #9ca3af;
    font-style: italic;
  }
  .prose hr {
    border-color: #374151;
    margin: 2rem 0;
  }
  /* Callout/Notice styles */
  .prose-callout p {
    margin-bottom: 0.75rem;
  }
  .prose-callout p:last-child {
    margin-bottom: 0;
  }
  .prose-callout strong {
    color: white;
  }
  .prose-callout em {
    color: #d1d5db;
  }
  .blog-toc {
    border: 1px solid #374151;
    border-radius: 0.5rem;
    color: #9ca3af;
    padding: 1rem;
  }
  @media (min-width: 1024px) {
    .blog-toc {
      border: 0;
      border-left: 1px solid #374151;
      border-radius: 0;
      padding: 2rem 1.5rem 0;
      position: sticky !important;
      top: 4rem !important;
    }
    .blog-toc ul {
      border-left: 0;
    }
  }
  .blog-toc-title {
    color: #f9fafb;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .blog-toc ul {
    border-left: 1px solid #374151;
    margin: 0;
    padding: 0;
  }
  .blog-toc li {
    list-style: none;
    margin: 0;
  }
  .blog-toc a {
    border-left: 2px solid transparent;
    display: block;
    font-size: 0.875rem;
    line-height: 1.4;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem 1rem;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .blog-toc a:hover {
    border-color: #60a5fa;
    color: #93c5fd;
  }
  .blog-toc-nested a {
    font-size: 0.8125rem;
    padding-left: 1.75rem;
  }
  /* KaTeX overrides */
  .katex {
    font-size: 1.1em;
  }
  .katex-display {
    margin: 1.5rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>
